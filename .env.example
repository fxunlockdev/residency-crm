# ---- Required ----
# Railway injects this automatically when you attach a Postgres service.
DATABASE_URL="postgresql://user:password@host:5432/railway"
# 32+ random chars. Generate with: openssl rand -base64 48
AUTH_SECRET=""
# Absolute path of the mounted Railway volume used for document storage.
UPLOAD_DIR="/data/uploads"
# Public origin of the app, used in emails and the lead-capture snippet.
APP_URL="https://crm.residencyfirst.com"
# Shared secret the website enquiry form sends in the x-rf-token header.
# REQUIRED: the lead endpoint returns 503 until this is set, rather than
# accepting anonymous writes. Note the value is visible in the marketing site's
# page source, so it is a speed bump, not authentication — the origin allowlist
# and rate limits below are the real controls.
LEAD_INTAKE_TOKEN=""

# Comma-separated origins allowed to POST the enquiry form. An empty list
# means no cross-origin browser submissions are accepted at all.
LEAD_ALLOWED_ORIGINS="https://residencyfirst.com,https://www.residencyfirst.com"

# ---- First boot only ----
# When the users table is empty, these create the first administrator. Remove
# them once you have signed in and changed the password.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Nick Mustafa"

# ---- Optional: Google Ads offline conversions ----
# Leave blank to keep the conversion queue dormant (events are still recorded).
GOOGLE_ADS_CUSTOMER_ID=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
GOOGLE_ADS_CONVERSION_LEAD=""
GOOGLE_ADS_CONVERSION_ENGAGED=""
GOOGLE_ADS_CONVERSION_FUNDED=""

# Spend ingestion uses the same credentials with read scope. Schedule a daily
# call to /api/cron/google-ads-spend with the CRON_SECRET below.
#
# For spend to join to leads, set this Final URL suffix in Google Ads:
#   gclid={gclid}&campaignid={campaignid}&adgroupid={adgroupid}&keyword={keyword}&matchtype={matchtype}
# A GCLID identifies a click, not a campaign; {campaignid} is the join key, and
# unlike a campaign name it does not change when somebody renames things.""

# ---- Email: enquiry alerts and the daily digest ----
# MailerSend is MailerLite's transactional product. MailerLite itself only
# sends campaigns to lists, so it cannot send a one-off alert.
# The sending domain must be verified in MailerSend or every send is rejected.
MAILERSEND_API_TOKEN=""
ALERT_EMAIL_FROM="crm@residencyfirst.com"
# Where the daily ops digest goes.
ALERT_EMAIL_TO=""
# Where website enquiry alerts go. Falls back to ALERT_EMAIL_TO when unset.
LEAD_NOTIFY_TO=""

# ---- MailerLite: the EB-5 deadline updates list ----
# Signups are stored in this database either way. These push a copy into
# MailerLite so the marketing team can send to them.
MAILERLITE_API_KEY=""
# Group ids from MailerLite, one per channel the website offers. Find them in
# the group's URL, or with: GET https://connect.mailerlite.com/api/groups
MAILERLITE_GROUP_EMAIL=""
MAILERLITE_GROUP_WHATSAPP=""
# Only set this if a field with this key exists in the account. MailerLite
# rejects the whole subscriber when a fields key is unknown.
MAILERLITE_PHONE_FIELD=""

# ---- Required for scheduled jobs ----
# Both cron routes reject every request until this is set, so the daily digest
# and the Google Ads conversion upload will not run without it.
CRON_SECRET=""
