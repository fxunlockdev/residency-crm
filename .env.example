# ---- Required ----
# Railway injects this automatically when you attach a Postgres service.
DATABASE_URL="postgresql://user:password@host:5432/railway"
# 32+ random chars. Generate with: openssl rand -base64 48
AUTH_SECRET=""
# Absolute path of the mounted Railway volume used for document storage.
UPLOAD_DIR="/data/uploads"
# Public origin of the app, used in emails and the lead-capture snippet.
APP_URL="https://crm.residencyfirst.com"
# Shared secret the website enquiry form sends in the x-rf-token header.
LEAD_INTAKE_TOKEN=""

# ---- Optional: Google Ads offline conversions ----
# Leave blank to keep the conversion queue dormant (events are still recorded).
GOOGLE_ADS_CUSTOMER_ID=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
GOOGLE_ADS_CONVERSION_LEAD=""
GOOGLE_ADS_CONVERSION_ENGAGED=""
GOOGLE_ADS_CONVERSION_FUNDED=""

# ---- Optional: email digests ----
RESEND_API_KEY=""
ALERT_EMAIL_TO=""
ALERT_EMAIL_FROM="crm@residencyfirst.com"

# ---- Optional: cron protection ----
CRON_SECRET=""
